{
  "name": "@dinero.js/monorepo",
  "version": "2.0.2",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.11.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "scripts": {
    "build:clean": "turbo build:clean",
    "build": "turbo build --filter=./packages/*",
    "format": "prettier --write .",
    "lint": "oxlint packages/ test/",
    "prepare": "husky && npm run build",
    "release": "shipjs prepare",
    "test:size": "size-limit",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "docs:dev": "npm run dev -w @dinero.js/docs",
    "docs:build": "npm run build -w @dinero.js/docs",
    "docs:preview": "npm run preview -w @dinero.js/docs"
  },
  "devDependencies": {
    "@size-limit/file": "^12.0.0",
    "@types/big.js": "6.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "big.js": "^7.0.1",
    "fast-check": "^4.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.42.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "shipjs": "^0.28.0",
    "size-limit": "^12.0.0",
    "turbo": "^2.8.14",
    "typescript": "^5.7.3",
    "typesugar": "file:vendor/typesugar/typesugar-0.1.1-2da17ee3.tgz",
    "unplugin-typesugar": "file:vendor/typesugar/unplugin-typesugar-0.1.1-2da17ee3.tgz",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "typesugar": "$typesugar",
    "@typesugar/contracts": "file:vendor/typesugar/typesugar-contracts-0.1.1-2da17ee3.tgz",
    "@typesugar/core": "file:vendor/typesugar/typesugar-core-0.1.1-2da17ee3.tgz",
    "@typesugar/derive": "file:vendor/typesugar/typesugar-derive-0.1.1-2da17ee3.tgz",
    "@typesugar/fp": "file:vendor/typesugar/typesugar-fp-0.1.1-2da17ee3.tgz",
    "@typesugar/lsp-common": "file:vendor/typesugar/typesugar-lsp-common-0.1.1-2da17ee3.tgz",
    "@typesugar/macros": "file:vendor/typesugar/typesugar-macros-0.1.1-2da17ee3.tgz",
    "@typesugar/reflect": "file:vendor/typesugar/typesugar-reflect-0.1.1-2da17ee3.tgz",
    "@typesugar/std": "file:vendor/typesugar/typesugar-std-0.1.1-2da17ee3.tgz",
    "@typesugar/transformer": "file:vendor/typesugar/typesugar-transformer-0.1.1-2da17ee3.tgz",
    "@typesugar/transformer-core": "file:vendor/typesugar/typesugar-transformer-core-0.1.1-2da17ee3.tgz",
    "@typesugar/type-system": "file:vendor/typesugar/typesugar-type-system-0.1.1-2da17ee3.tgz",
    "@typesugar/typeclass": "file:vendor/typesugar/typesugar-typeclass-0.1.1-2da17ee3.tgz",
    "unplugin-typesugar": "$unplugin-typesugar"
  }
}
